# CRM Application Environment Variables

# Node environment (development or production)
NODE_ENV=production

# Server port and host
PORT=5173
HOST=0.0.0.0

# Database (SQLite by default; change to PostgreSQL for scaling)
# Local development:
# DATABASE_URL=file:./server/crm.db

# Docker/production:
DATABASE_URL=file:/app/data/crm.db

# Optional: PostgreSQL for multi-instance deployments
# DATABASE_URL=postgresql://user:password@localhost:5432/crm

# Client distribution folder (usually not needed to change)
CLIENT_DIST=/app/client/dist

# Optional: Sentry error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: JWT secret (auto-generated if not provided)
# JWT_SECRET=your-secret-key-here

# Optional: Allowed CORS origins (comma-separated, production only)
# CORS_ORIGINS=https://crm.yourcompany.com,https://www.yourcompany.com
